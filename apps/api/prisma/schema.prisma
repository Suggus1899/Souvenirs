generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ASSISTANT
}

enum Plan {
  FREE
  PRO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  STRIPE
  PAGO_MOVIL
  ZELLE
  BINANCE_USDT
  CASH_VES
  OTHER
}

enum ReminderRelatedType {
  BOOKING
  INVOICE
}

enum ReminderChannel {
  PUSH
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
}

enum Platform {
  IOS
  ANDROID
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  plan            Plan     @default(FREE)
  stripeAccountId String?
  stripeOnboarded Boolean  @default(false)
  createdAt       DateTime @default(now())

  users      User[]
  clients    Client[]
  services   Service[]
  bookings   Booking[]
  invoices   Invoice[]
  payments   Payment[]
  reminders  Reminder[]
  pushTokens PushToken[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  role         Role     @default(OWNER)
  name         String
  createdAt    DateTime @default(now())

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingsCreated Booking[]   @relation("BookingCreatedBy")
  pushTokens      PushToken[]

  @@index([tenantId])
  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]
  invoices Invoice[]

  @@index([tenantId])
  @@map("clients")
}

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  basePrice       Decimal  @db.Decimal(10, 2)
  durationMinutes Int

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@map("services")
}

model Booking {
  id              String        @id @default(cuid())
  tenantId        String
  clientId        String
  serviceId       String?
  title           String
  scheduledAt     DateTime
  durationMinutes Int
  location        String?
  status          BookingStatus @default(PENDING)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User      @relation("BookingCreatedBy", fields: [createdById], references: [id])
  invoices  Invoice[]

  @@index([tenantId])
  @@index([scheduledAt])
  @@map("bookings")
}

model Invoice {
  id                      String        @id @default(cuid())
  tenantId                String
  bookingId               String?
  clientId                String
  totalAmount             Decimal       @db.Decimal(10, 2)
  currency                String        @default("USD")
  status                  InvoiceStatus @default(DRAFT)
  dueDate                 DateTime?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paymentLinkUrl          String?
  createdAt               DateTime      @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId])
  @@index([clientId])
  @@map("invoices")
}

model Payment {
  id                    String        @id @default(cuid())
  tenantId              String
  invoiceId             String
  amount                Decimal       @db.Decimal(10, 2)
  method                PaymentMethod @default(CASH)
  stripePaymentIntentId String?
  paidAt                DateTime      @default(now())
  notes                 String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

model Reminder {
  id          String              @id @default(cuid())
  tenantId    String
  relatedType ReminderRelatedType
  relatedId   String
  remindAt    DateTime
  channel     ReminderChannel     @default(PUSH)
  status      ReminderStatus      @default(PENDING)
  message     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([relatedType, relatedId])
  @@index([remindAt, status])
  @@map("reminders")
}

model PushToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("push_tokens")
}

enum ExchangeRateSource {
  BCV
  PARALELO
}

// Not tenant-scoped: the USD/VES rate is shared reference data, not per-tenant business data.
model ExchangeRate {
  id        String             @id @default(cuid())
  source    ExchangeRateSource @unique
  rate      Decimal            @db.Decimal(12, 4)
  fetchedAt DateTime           @default(now())

  @@map("exchange_rates")
}
