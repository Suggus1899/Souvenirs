generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ASSISTANT
}

enum Plan {
  FREE
  PRO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  STRIPE
  PAGO_MOVIL
  ZELLE
  BINANCE_USDT
  CASH_VES
  OTHER
}

enum ReminderRelatedType {
  BOOKING
  INVOICE
}

enum ReminderChannel {
  PUSH
  EMAIL
}

enum ReminderRecipient {
  OWNER
  CLIENT
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
}

enum Platform {
  IOS
  ANDROID
}

model Tenant {
  id                     String   @id @default(cuid())
  name                   String
  plan                   Plan     @default(FREE)
  stripeAccountId        String?
  stripeOnboarded        Boolean  @default(false)
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  subscriptionStatus     String?
  /// Days relative to an invoice's due date at which reminders go out (negative = before).
  reminderOffsetsDays    Int[]    @default([-3, 0, 3])
  /// Whether reminder emails also go to the invoice's client, not only to the studio.
  clientRemindersEnabled Boolean  @default(true)
  createdAt              DateTime @default(now())

  users        User[]
  clients      Client[]
  services     Service[]
  bookings     Booking[]
  invoices     Invoice[]
  payments     Payment[]
  reminders    Reminder[]
  pushTokens   PushToken[]
  invoiceItems InvoiceItem[]

  @@unique([stripeAccountId])
  @@unique([stripeCustomerId])
  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  role         Role     @default(OWNER)
  name         String
  createdAt    DateTime @default(now())

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingsCreated     Booking[]            @relation("BookingCreatedBy")
  pushTokens          PushToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]
  invoices Invoice[]

  @@index([tenantId, createdAt])
  @@map("clients")
}

model Service {
  id              String  @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  basePrice       Decimal @db.Decimal(10, 2)
  durationMinutes Int

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@map("services")
}

model Booking {
  id              String        @id @default(cuid())
  tenantId        String
  clientId        String
  serviceId       String?
  title           String
  scheduledAt     DateTime
  durationMinutes Int
  location        String?
  status          BookingStatus @default(PENDING)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User      @relation("BookingCreatedBy", fields: [createdById], references: [id])
  invoices  Invoice[]

  @@index([tenantId, scheduledAt])
  @@map("bookings")
}

model Invoice {
  id                      String        @id @default(cuid())
  tenantId                String
  /// Sequential per tenant (1, 2, 3...), shown to clients as the invoice number.
  number                  Int
  /// Unguessable id for the client-facing payment page (/pay/:publicToken).
  publicToken             String        @unique
  notes                   String?
  sentAt                  DateTime?
  bookingId               String?
  clientId                String
  totalAmount             Decimal       @db.Decimal(10, 2)
  currency                String        @default("USD")
  status                  InvoiceStatus @default(DRAFT)
  dueDate                 DateTime?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paymentLinkUrl          String?
  createdAt               DateTime      @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  payments Payment[]
  items    InvoiceItem[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  tenantId    String
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  position    Int

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                    String        @id @default(cuid())
  tenantId              String
  invoiceId             String
  amount                Decimal       @db.Decimal(10, 2)
  method                PaymentMethod @default(CASH)
  stripePaymentIntentId String?
  paidAt                DateTime      @default(now())
  notes                 String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([stripePaymentIntentId])
  @@index([tenantId, paidAt])
  @@index([invoiceId])
  @@map("payments")
}

model Reminder {
  id             String              @id @default(cuid())
  tenantId       String
  relatedType    ReminderRelatedType
  relatedId      String
  remindAt       DateTime
  channel        ReminderChannel     @default(PUSH)
  recipient      ReminderRecipient   @default(OWNER)
  /// Snapshot of the client's email for CLIENT reminders.
  recipientEmail String?
  status         ReminderStatus      @default(PENDING)
  message        String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status, remindAt])
  @@map("reminders")
}

model PushToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("push_tokens")
}

enum ExchangeRateSource {
  BCV
  PARALELO
}

// Not tenant-scoped: the USD/VES rate is shared reference data, not per-tenant business data.
model ExchangeRate {
  id        String             @id @default(cuid())
  source    ExchangeRateSource @unique
  rate      Decimal            @db.Decimal(12, 4)
  fetchedAt DateTime           @default(now())

  @@map("exchange_rates")
}

// Not tenant-scoped on purpose: used before login (forgot password, accepting an invite).
// Only the hash of the token is stored; the raw token travels once, in the email link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
