DATABASE_URL="postgresql://user:password@localhost:5432/souvenirs?schema=public&connection_limit=10"
# Non-owner role used for tenant-scoped runtime queries — subject to Row Level Security.
# The DATABASE_URL role above must remain the table owner (used for migrations only).
DATABASE_URL_RUNTIME="postgresql://app_runtime:password@localhost:5432/souvenirs?schema=public&connection_limit=10"
JWT_SECRET="changeme"
JWT_EXPIRES_IN_SECONDS=86400
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID of the platform's own "Pro" subscription product (Dashboard > Product catalog > + Add product,
# recurring $15/month) — distinct from the per-tenant Connect accounts used to charge their own clients.
STRIPE_PRO_PRICE_ID="price_..."
WEB_APP_URL="http://localhost:3001"
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="reminders@souvenirs.dev"
# CORS_ORIGIN="https://app.souvenirs.dev,https://souvenirs.dev" # comma-separated; unset allows any origin
